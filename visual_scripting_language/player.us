//class takes like, two arguments. class-name, inherits-from

namespace Game{

ufo_category 'MyGame' ufo_actor_config 'player.ason'
class Player ufo::Actor
{

    Sprite sprite; //Infer pointer, since not of type int, float or string

    map<int, string> enum_to_string_map;

    vector<int> out_of_ideas = {3 2 1}

    function OnSpawn{
        sprite = this.GetActor('InstSprite') //Automatic cast?

        if !sprite, Console::PrintLine('error, no sprite present')
    }

    function SetStateWalk -> bool {
        return false;
    }

    function OnUpdate _delta_time{

        bool direction = @engine.input.GetKey(K_RIGHT).is_held

        local_position.x += direction * _delta_time

        Console::PrintLine('Hello world')

        if direction != 0 {
            sprite.scale = direction
        }
    }

}

}
